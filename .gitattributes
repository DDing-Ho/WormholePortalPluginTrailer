# Keep source and configuration files consistent across Windows and CI.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unreal assets are binary and should not be merged as text.
*.uasset -text
*.umap -text

# Common binary source assets.
*.fbx -text
*.blend -text
*.psd -text
*.exr -text
*.hdr -text
*.wav -text
*.mp3 -text
*.ogg -text
*.mp4 -text
*.mov -text

*.png -text
*.jpg -text
*.jpeg -text
*.tga -text
*.ico -text
