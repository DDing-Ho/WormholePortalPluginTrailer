//
// TEMPORARY workaround: restore tagged main-view foreground translucency over
// every valid WPComposite optical branch (local SceneColor lens, linked cubemap,
// and trapped-critical output).

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "WPRayCommon.ush"

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Base)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

Texture2D InputTexture;
SamplerState InputSampler;
Texture2D BaseSceneColorTexture;
SamplerState BaseSceneColorSampler;
Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;
Texture2D CustomDepthTexture;
Texture2D<uint2> CustomStencilTexture;
Texture3D RayLUTTexture;
SamplerState RayLUTSampler;

float RayLUTZ;
float RayLUTEnabled;
float3 PortalCenterTranslated;
float PortalRadiusCm;
float ThroatLengthCm;
float ProxyRadiusCm;
float CompositeDepthBiasCm;
float TemporaryFrontDepthBiasCm;
uint TemporaryCustomStencilValue;
float3 SelfX;
float3 SelfY;
float3 SelfZ;
float3 LinkedX;
float3 LinkedY;
float3 LinkedZ;

bool WPTemporarySelectSphereHit(
    float3 RayOrigin,
    float3 RayDirection,
    float3 SphereCenter,
    float SphereRadius,
    out float SelectedT,
    out bool bCameraInside,
    out float2 HitDistances)
{
    const float3 OriginToCenter = RayOrigin - SphereCenter;
    const float RadiusSquared = SphereRadius * SphereRadius;
    const float OriginDistanceSquared = dot(OriginToCenter, OriginToCenter);
    bCameraInside = OriginDistanceSquared < RadiusSquared;

    const float ProjectedOrigin = dot(OriginToCenter, RayDirection);
    const float Discriminant = ProjectedOrigin * ProjectedOrigin
        - (OriginDistanceSquared - RadiusSquared);
    if (Discriminant < 0.0f)
    {
        SelectedT = 0.0f;
        HitDistances = 0.0f;
        return false;
    }

    const float Root = sqrt(max(Discriminant, 0.0f));
    HitDistances = float2(-ProjectedOrigin - Root, -ProjectedOrigin + Root);
    SelectedT = bCameraInside ? HitDistances.y : HitDistances.x;
    return SelectedT > 1.0e-4f;
}

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
    ResolvedView = ResolveView();

    const float2 OutputViewportUV =
        (SvPosition.xy - float2(Output_ViewportMin)) * Output_ViewportSizeInverse;
    const float2 GeometryViewportUV = OutputViewportUV
        + float2(0.5f, -0.5f) * ResolvedView.TemporalAAJitter.xy;
    const float2 InputUV = clamp(
        (OutputViewportUV * Input_ViewportSize + float2(Input_ViewportMin)) * Input_ExtentInverse,
        Input_UVViewportBilinearMin,
        Input_UVViewportBilinearMax);
    const float4 CompositeSceneColor = InputTexture.SampleLevel(InputSampler, InputUV, 0.0f);
    OutColor = CompositeSceneColor;

    const float2 ScreenPosition = ViewportUVToScreenPos(GeometryViewportUV);
    const float3 RayOrigin = ResolvedView.TranslatedWorldCameraOrigin;
    const float3 RayDirection = normalize(
        ScreenVectorFromScreenRect(float4(ScreenPosition, 1.0f, 0.0f), ResolvedView));

    float OuterHitT = 0.0f;
    bool bCameraInsideOuter = false;
    float2 OuterHitDistances = 0.0f;
    if (!WPTemporarySelectSphereHit(
        RayOrigin,
        RayDirection,
        PortalCenterTranslated,
        ProxyRadiusCm,
        OuterHitT,
        bCameraInsideOuter,
        OuterHitDistances))
    {
        return;
    }

    const float3 CameraOffset = RayOrigin - PortalCenterTranslated;
    const float CoverageCarrierRadius = ProxyRadiusCm * 1.05f;
    const bool bUseFarCoverageRoot = dot(CameraOffset, CameraOffset)
        < CoverageCarrierRadius * CoverageCarrierRadius;
    const float CoverageHitT = bUseFarCoverageRoot
        ? OuterHitDistances.y
        : OuterHitDistances.x;
    if (CoverageHitT <= 1.0e-4f)
    {
        return;
    }

    const float3 CoverageHitTranslated = RayOrigin + RayDirection * CoverageHitT;
    const float4 CoverageHitClip = mul(
        float4(CoverageHitTranslated, 1.0f),
        ResolvedView.TranslatedWorldToClip);
    if (CoverageHitClip.w <= 0.0f || CoverageHitClip.z > CoverageHitClip.w)
    {
        return;
    }

    float PortalVisibility = 1.0f;
    const float3 OuterHitTranslated = RayOrigin + RayDirection * OuterHitT;
    const float4 OuterHitClip = mul(
        float4(OuterHitTranslated, 1.0f),
        ResolvedView.TranslatedWorldToClip);
    if (!bCameraInsideOuter)
    {
        const float2 SceneDepthUV = clamp(
            ViewportUVToBufferUV(GeometryViewportUV),
            ResolvedView.BufferBilinearUVMinMax.xy,
            ResolvedView.BufferBilinearUVMinMax.zw);
        const float DeviceZ = SceneDepthTexture.SampleLevel(
            SceneDepthSampler,
            SceneDepthUV,
            0.0f).r;
        const float SceneDepthCm = ConvertFromDeviceZ(DeviceZ);
        const float DepthDeltaCm =
            SceneDepthCm + CompositeDepthBiasCm - OuterHitClip.w;
        const float AutoFeatherCm = abs(ddx(DepthDeltaCm)) + abs(ddy(DepthDeltaCm));
        const float DepthFeatherCm = clamp(max(AutoFeatherCm, 2.0f), 2.0f, 50.0f);
        PortalVisibility = smoothstep(
            -DepthFeatherCm,
            DepthFeatherCm,
            DepthDeltaCm);
        if (PortalVisibility <= 0.001f)
        {
            return;
        }
    }

    const FWPRayResult RayResult = WPEvaluateRay(
        RayLUTTexture,
        RayLUTSampler,
        RayLUTZ,
        RayLUTEnabled,
        RayDirection,
        CameraOffset,
        PortalRadiusCm,
        ThroatLengthCm,
        ProxyRadiusCm,
        SelfX,
        SelfY,
        SelfZ,
        LinkedX,
        LinkedY,
        LinkedZ,
        ResolvedView.ViewRight,
        ResolvedView.ViewUp);
    // Foreground translucency belongs to the main camera after the wormhole
    // optical result. Restricting this to UseOtherUniverse made the linked cube
    // correct but still allowed the local SceneColor branch to distort the same
    // tagged foreground surface. RayResult.Valid covers every pixel changed by
    // WPComposite, including local lens and trapped-critical output.
    const bool bWormholeCompositePixel = RayResult.Valid > 0.5f;
    if (!bWormholeCompositePixel)
    {
        return;
    }

    uint CustomDepthWidth = 1;
    uint CustomDepthHeight = 1;
    CustomDepthTexture.GetDimensions(CustomDepthWidth, CustomDepthHeight);
    const float2 CustomDepthSize = max(
        float2((float)CustomDepthWidth, (float)CustomDepthHeight),
        1.0f.xx);
    const float2 CustomDepthUV = clamp(
        ViewportUVToBufferUV(GeometryViewportUV),
        ResolvedView.BufferBilinearUVMinMax.xy,
        ResolvedView.BufferBilinearUVMinMax.zw);
    const int2 CustomDepthPixel = clamp(
        int2(CustomDepthUV * CustomDepthSize),
        int2(0, 0),
        int2(CustomDepthWidth - 1, CustomDepthHeight - 1));
    const uint CustomStencil = CustomStencilTexture.Load(
        int3(CustomDepthPixel, 0)) STENCIL_COMPONENT_SWIZZLE;
    if (CustomStencil != TemporaryCustomStencilValue)
    {
        return;
    }

    const float CustomDeviceZ = CustomDepthTexture.Load(
        int3(CustomDepthPixel, 0)).r;
    const float CustomDepthCm = ConvertFromDeviceZ(CustomDeviceZ);
    const bool bTaggedTranslucencyInFront = isfinite(CustomDepthCm)
        && CustomDepthCm + TemporaryFrontDepthBiasCm < OuterHitClip.w;
    if (!bTaggedTranslucencyInFront)
    {
        return;
    }

    const float2 BaseUV = clamp(
        (OutputViewportUV * Base_ViewportSize + float2(Base_ViewportMin))
            * Base_ExtentInverse,
        Base_UVViewportBilinearMin,
        Base_UVViewportBilinearMax);
    const float3 BaseSceneColor = BaseSceneColorTexture.SampleLevel(
        BaseSceneColorSampler,
        BaseUV,
        0.0f).rgb;
    OutColor.rgb = lerp(CompositeSceneColor.rgb, BaseSceneColor, PortalVisibility);
}
